# SECURITY FIX (CIA-06): .dockerignore prevents credentials from baking into the image.
# Without this file, COPY . . would include .env files with DISCORD_TOKEN, API keys, etc.

.env
.env.*
.env.local
.env.development
.env.production

node_modules
npm-debug.log
yarn-error.log

data/
*.log

.git
.gitignore
.npmrc

# Dev/test only
*.test.js
*.spec.js
__tests__/
coverage/

# Build artifacts
dist/
build/

# Local docs
*.md
!README.md

# OS
.DS_Store
Thumbs.db

# Runtime league builder is source, not a generated build directory.
!src/league/build/
!src/league/build/**
