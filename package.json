{
  "name": "commishai-bot",
  "version": "21.11.0-rc.3",
  "description": "CommishAI AI-powered Discord league operations platform",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node index.js",
    "start:prod": "node index.js",
    "dev": "node --watch index.js",
    "restart": "node index.js",
    "doctor": "node scripts/doctor.js",
    "tsc": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "db:bootstrap": "node scripts/db-bootstrap.js",
    "db:migrate-json": "node scripts/migrate-json-to-postgres.js",
    "db:export-json": "node scripts/export-postgres-to-json.js",
    "stack:init": "npm run prisma:generate && npm run db:bootstrap && npm run db:migrate-json",
    "queue:worker": "node src/queue/worker.js",
    "postinstall": "prisma generate",
    "repair:deps": "npm ci",
    "start:railway": "sh scripts/railway-start.sh",
    "start:health": "node health-server.js",
    "release:verify": "node scripts/changelog-guard.js && node scripts/doctor.js && node scripts/command-contract-check.js && node scripts/check-undefined-identifiers.js && node scripts/contract-v8-static-check.js && node scripts/contract-v8-g2-g3-check.js && node scripts/dependency-cycle-check.js && npm test",
    "deploy:preflight": "node scripts/predeploy-check.js",
    "deploy:context": "node scripts/release-context.js",
    "infra:check": "node scripts/check-infra.js",
    "precommit:run": "node scripts/pre-commit-check.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "process:audit": "node scripts/pre-commit-check.js",
    "test": "node tests/run-all.js",
    "static:undefined": "node scripts/check-undefined-identifiers.js",
    "command:contract": "node scripts/command-contract-check.js",
    "schema:check": "node scripts/schema-readiness.js",
    "test:postgres": "node tests/postgres.integration.js && node tests/g2.postgres.integration.js",
    "verify:local": "node scripts/verify-local.js",
    "release:v2047:final": "bash scripts/v2047-final-release-gate.sh",
    "contract:v8:static": "node scripts/contract-v8-static-check.js",
    "contract:v8:g2g3": "node scripts/contract-v8-g2-g3-check.js && node tests/contractV8G2G3.regression.test.js",
    "static:cycles": "node scripts/dependency-cycle-check.js",
    "test:g2:postgres": "node tests/g2.postgres.integration.js",
    "g2:certify": "node scripts/g2-release-certify.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@prisma/client": "6.19.3",
    "adm-zip": "0.6.1",
    "bullmq": "^5.16.0",
    "discord.js": "^14.15.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "undici": "6.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "6.19.3",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
