# Core Discord runtime
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_discord_application_client_id
GUILD_ID=your_test_or_primary_guild_id
COMMISSIONER_ROLE_ID=your_commissioner_role_id

# Deployment metadata
APP_ENV=production
RELEASE_CHANNEL=release-candidate
RELEASE_VERSION=21.11.0-rc.3

# Guarded boot flags
RUN_PRISMA_MIGRATIONS_ON_BOOT=false
RUN_DB_BOOTSTRAP_ON_BOOT=false
RUN_JSON_MIGRATION_ON_BOOT=false
ENABLE_QUEUE_WORKER=true

# Persistent app data on Railway
BOT_DATA_DIR=/data
# Attach a persistent Railway volume at /data. Confirm its ownership is writable
# by the container user; if the mounted volume is root-owned, configure the
# Railway runtime UID appropriately for your deployment and verify /ready.

# Railway databases
# PREFERRED: set these in the Railway NOFUNBOT Variables UI as service references:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
# Use your exact Railway service names. Never use localhost for a separate Railway DB/Redis service.
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
REDIS_URL=redis://default:password@redis.railway.internal:6379

# AI — set the real value in Railway and seal it. Placeholder values are rejected in production.
AI_ENABLED=true
ANTHROPIC_API_KEY=replace_me


# v204.7 Madden/provider ingress
PUBLIC_BASE_URL=https://your-nofunbot-domain.example
ENABLE_PROVIDER_HTTP=true
PROVIDER_HTTP_PORT=3100
PROVIDER_SECRET_KEY=replace_with_32_plus_byte_random_secret
ALLOW_JSON_PROVIDER_RECEIPTS=false
ALLOW_JSON_PROVIDER_CONNECTIONS=false

# v204.7 passive conversation awareness
BOT_AMBIENT_CONTEXT_MINUTES=30
BOT_AMBIENT_CONTEXT_MAX_MESSAGES=32
ENABLE_TRASH_TALK_LEARNING=false
BOT_NL_PENDING_MINUTES=5
BOT_NL_MAX_PENDING=250
