# ─────────────────────────────────────────────────────────────────
# NOFUNLEAGUE Bot — Environment Variables
# Copy this file to .env and fill in your values.
# All REQUIRED vars must be set or the bot will refuse to start.
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────

# Discord bot token (from Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=your_discord_bot_token

# Discord application/client ID (Developer Portal → General → Application ID)
CLIENT_ID=your_discord_application_client_id

# The single guild/server ID this bot manages
GUILD_ID=your_primary_guild_id


# ── STRONGLY RECOMMENDED (missing = degraded auth / no persistence) ──

# The Discord Role ID of your Commissioner role (right-click role → Copy ID).
# Without this, commissioner checks fall back to Discord's Administrator permission.
# Anyone with server Admin will have full bot access — not what you want in production.
COMMISSIONER_ROLE_ID=your_commissioner_role_id

# PostgreSQL connection string. Without this, ALL state resets on every restart.
# LOCAL DEVELOPMENT example below. Railway MUST use a Postgres service reference, never localhost.
# Railway Variables: DATABASE_URL=${{Postgres.DATABASE_URL}} (use the exact service name).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nofunleague?schema=public

# Redis connection string. Without this, the BullMQ queue worker won't start and
# all background job/storage-sync operations silently do nothing.
# LOCAL DEVELOPMENT example below. Railway MUST use a Redis service reference, never localhost.
# Railway Variables: REDIS_URL=${{Redis.REDIS_URL}} (use the exact service name).
REDIS_URL=redis://localhost:6379

# Path for JSON flat-file fallback storage.
# Railway IMPORTANT: set this to a Railway Volume mount path (e.g. /data) so state
# survives restarts. If left unset, defaults to /tmp which is wiped on every deploy.
BOT_DATA_DIR=/data


# ── AI (optional — bot works without it, AI responses disabled) ──

# Anthropic API key for AI responses. In production, set a real secret in Railway; placeholders are rejected.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Set to false to disable AI entirely even if key is present
AI_ENABLED=true

# Override default models (defaults shown — usually leave these unset)
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_SMART=claude-sonnet-4-6

# AI response timeout in milliseconds (default: 22000)
# AI_TIMEOUT_MS=22000

# OpenAI key (only needed if AI_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key

# Which AI provider to use: anthropic (default) or openai
# AI_PROVIDER=anthropic


# ── OPTIONAL ─────────────────────────────────────────────────────

# Comma-separated Discord user IDs that always have commissioner access,
# regardless of role. Useful for bot owner / emergency access.
# COMMISSIONER_IDS=123456789012345678,234567890123456789

# Port for the health check HTTP server (default: 3000)
# PORT=3000

# Set to production in Railway (enables SSL for DB, tightens logging)
# NODE_ENV=production

# ─── V202 League providers (all optional; defaults = previous behavior) ───
# Madden Companion export gateway: long random token used in the export URL
#   POST /v1/providers/madden/companion/export/<COMPANION_EXPORT_TOKEN>
# COMPANION_EXPORT_TOKEN=
# NeonSportz import-completed webhook shared secret (header x-webhook-secret or ?secret=)
# NEONSPORTZ_WEBHOOK_SECRET=
# NeonSportz read-only snapshot endpoint (https) + optional bearer token + league id
# NEONSPORTZ_SNAPSHOT_URL=
# NEONSPORTZ_API_TOKEN=
# NEONSPORTZ_LEAGUE_ID=
# In-process receiver for the two routes above (off by default). Must be publicly reachable to receive exports.
# ENABLE_PROVIDER_HTTP=false
# PROVIDER_HTTP_PORT=3100

# ─── V204.7 Conversation intelligence (optional; safe defaults shown) ───
# Passive context is memory-only and NEVER replies by itself. Conversational AI still requires explicit @mention.
# BOT_AMBIENT_CONTEXT_MINUTES=30
# BOT_AMBIENT_CONTEXT_MAX_MESSAGES=32
# BOT_AMBIENT_CONTEXT_MESSAGE_CHARS=280
# BOT_AMBIENT_CONTEXT_RENDER_CHARS=2600
# Short-lived clarification state for natural actions such as "put Paul on the Ravens".
# BOT_NL_PENDING_MINUTES=5

# ─── V204.7 provider connection framework (preferred production configuration) ───
# Public HTTPS origin that forwards /v1/providers/* to the internal provider HTTP service.
# PUBLIC_BASE_URL=https://your-bot.example.com
# Enable provider HTTP receiver in production when using Companion Direct or NeonSportz push callbacks.
# ENABLE_PROVIDER_HTTP=true
# PROVIDER_HTTP_PORT=3100
# 32+ byte random key material used to derive the AES-256-GCM provider-secret key.
# PROVIDER_SECRET_KEY=
# Optional compatibility override. Production normally requires durable DB-backed provider receipts/connections.
# ALLOW_JSON_PROVIDER_RECEIPTS=false
# ALLOW_JSON_PROVIDER_CONNECTIONS=false
# Passive conversation observation remains local/in-memory only.
# ENABLE_TRASH_TALK_LEARNING=false
# Optional comma-separated channel IDs explicitly excluded/included by ambient context service.
# BOT_AMBIENT_DENY_CHANNEL_IDS=
# BOT_AMBIENT_ALLOW_CHANNEL_IDS=
# Bound pending natural-language clarifications.
# BOT_NL_MAX_PENDING=250


# ─── Public v1 release surface ───
# Internal package/engineering version may continue independently.
PUBLIC_RELEASE_VERSION=1.0.0
PUBLIC_RELEASE_CHANNEL=public-beta
PUBLIC_PATCH_NOTES_ENABLED=true

# Runtime production incident capture into the existing audit_events table.
RUNTIME_INCIDENT_CAPTURE_ENABLED=true
RUNTIME_INCIDENT_DEDUPE_MS=60000

# Crash-abandoned PREPARING league/event reservations older than this no longer consume a slot.
SPACE_PREPARING_TTL_MS=1800000

# ─── Conversational multimodal media context ───
# Lets member/commissioner/IT conversation understand Discord-hosted images, memes, GIFs, stickers, and short video frames.
# Raw media is not persisted. Only a short semantic description enters short-lived conversation memory.
MEDIA_CONTEXT_ENABLED=true
# Per media item fetch ceiling. Keep this bounded to control memory/API cost.
MEDIA_CONTEXT_MAX_BYTES=20971520
# Maximum media items analyzed from one message/reply chain.
MEDIA_CONTEXT_MAX_ITEMS=3
# Representative frames sampled from an animated GIF or short video.
MEDIA_CONTEXT_MAX_FRAMES=4
# Only the first bounded slice of video is sampled; audio is not transcribed.
MEDIA_CONTEXT_VIDEO_SECONDS=12
# Cache semantic media analysis for duplicate Discord retries/re-edits.
MEDIA_CONTEXT_CACHE_MS=300000
# Direct static-image budget sent to the vision API. Larger static images are skipped instead of overloading the request.
MEDIA_CONTEXT_MAX_STATIC_API_BYTES=4194304
# Optional override. Docker/Railway installs ffmpeg in the image, so normally leave this unset.
# FFMPEG_PATH=/usr/bin/ffmpeg
