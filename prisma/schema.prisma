/*
 * NAVIGATION HEADER
 * FILE: prisma/schema.prisma
 * LAYER: Database schema and seed layer
 * PURPOSE: Defines the database schema and persistence model.
 * LOOK HERE FIRST WHEN DEBUGGING: Search this file for exported functions, top-level listeners, and state writes.
 * RELATED FLOW: Used by persistence code and deployment/bootstrap workflows.
 * NOTE: Keep comments in sync when adding new processes, handlers, or state transitions.
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOFUNLEAGUE Bot Schema V109
// Hierarchy: server_config → communities → leagues → teams
//            server_config → events
//            users → user_communities → communities
//            communities → role_mappings
// ─────────────────────────────────────────────────────────────────────────────

model ServerConfig {
  id                  String    @id @default(cuid())
  guildId             String    @unique
  template            String?
  subtemplate         String?
  theme               String?
  timezoneGateEnabled Boolean   @default(false)
  setupComplete       Boolean   @default(false)
  botStatus           String    @default("active")
  audienceRating      String    @default("pg13")
  filterMode          String    @default("strict")
  toneProfile         Json?
  memberToneProfile   Json?
  commToneProfile     Json?
  botName             String    @default("myBot")
  allowGifReplies     Boolean   @default(true)
  requireTimezone     Boolean   @default(false)
  serverInitialized       Boolean   @default(false)
  useSharedToneProfile    Boolean   @default(false)
  setupCompletedAt        DateTime?
  botAvatarMode           String?
  botAvatarUrl            String?
  botAvatarEmoji          String?
  serverTemplate          String?
  serverSubtemplate       String?
  customStructureMode     String?
  customArrangementMode   String?   @default("auto")
  customCatalogSelections Json?     @default("[]")
  customTemplateSelections Json?     @default("[]")
  customSubtemplateSelections Json?  @default("[]")
  toneVisibility          String?   @default("public")
  ageWarningEnabled       Boolean   @default(true)
  payload                 Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  communities         Community[]
  events              Event[]
  guideStates         GuideState[]
  wizardState         WizardState?
  channelTopologies   ChannelTopology[]
  pendingOffenses     PendingOffense[]
  streamCredits       StreamCredit[]
  backgroundJobs      BackgroundJob[]
  memberLedgerEntries MemberLedger[]
  featureFlags        FeatureFlag[]

  @@map("server_config")
}

model User {
  id              String    @id @default(cuid())
  guildId         String
  userId          String
  timezone        String?
  timezoneLabel   String?
  nicknameBase    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  communities     UserCommunity[]
  teamMemberships TeamMember[]

  @@unique([guildId, userId])
  @@map("users")
}

model Community {
  id              String    @id @default(cuid())
  guildId         String
  name            String
  type            String    @default("social") // league, events, social, fanzone, competitive, community-driven, league-enabled, event-driven
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  serverConfig    ServerConfig  @relation(fields: [guildId], references: [guildId])
  members         UserCommunity[]
  leagues         League[]
  roleMappings    RoleMapping[]

  @@unique([guildId, name])
  @@map("communities")
}

model UserCommunity {
  userId          String
  communityId     String
  joinedAt        DateTime  @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  community       Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@map("user_communities")
}

model League {
  id              String    @id @default(cuid())
  communityId     String
  name            String
  game            String?
  seasonType      String?
  seasonWeeks     Int?
  isActive            Boolean   @default(true)
  leagueTypeId        String?
  builtCategoryIds    Json?     @default("[]")
  builtChannelIds     Json?     @default("[]")
  commissionerRoleId  String?
  isCustom            Boolean   @default(false)
  leagueTag           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  community       Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  teams           Team[]
  schedules       Schedule[]

  @@map("leagues")
}

model Team {
  id              String    @id @default(cuid())
  leagueId        String
  name            String
  displayName     String?
  location        String?
  logoUrl         String?
  isOpen          Boolean   @default(true)
  ownerId         String?
  displayTeam     String?
  replacementFor  String?
  isCustomTeam    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  league          League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  members         TeamMember[]

  @@unique([leagueId, name])
  @@map("teams")
}

model TeamMember {
  userId          String
  teamId          String
  joinedAt        DateTime  @default(now())

  user            User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@map("team_members")
}

model Event {
  id              String    @id @default(cuid())
  guildId         String
  name            String
  description     String?
  startTime       DateTime?
  endTime         DateTime?
  channelId       String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  serverConfig    ServerConfig  @relation(fields: [guildId], references: [guildId])

  @@map("events")
}

model RoleMapping {
  id              String    @id @default(cuid())
  guildId         String
  communityId     String?
  roleId          String
  roleName        String?
  purpose         String?   // community-access, league-member, event-attendee, etc.
  createdAt       DateTime  @default(now())

  community       Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@map("role_mappings")
}

model Schedule {
  id              String    @id @default(cuid())
  leagueId        String
  week            Int
  matchups        Json?
  postedAt        DateTime?
  advancedAt      DateTime?
  createdAt       DateTime  @default(now())

  league          League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, week])
  @@map("schedules")
}

// Legacy key-value store — kept for Railway deployments without full Postgres migration
model BotKv {
  key         String   @id
  value       Json
  source      String   @default("json")
  checksum    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("bot_kv")
}

model QueueAudit {
  id         BigInt   @id @default(autoincrement())
  queueName  String
  jobName    String
  status     String
  payload    Json?
  result     Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("queue_audit")
}

// ─────────────────────────────────────────────────────────────────────────────
// V110 ADDITIONS — Guide State, Wizard State, Channel Topology,
//                  Audit Events, Pending Offenses, Stream Credits,
//                  Feature Flags, Background Jobs, Member Ledger
// ─────────────────────────────────────────────────────────────────────────────

model GuideState {
  id                    String    @id @default(cuid())
  guildId               String
  channelId             String
  guideChannelRole      String    // setup-wizard | welcome | league-guide | community
  guideAnchorMessageId  String?
  pinnedGuideMessageId  String?
  lastActivityAt        DateTime?
  idleRefreshAfterMs    Int       @default(900000)
  lastRenderedStateHash String?
  lastRefreshReason     String?
  lastRefreshAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  serverConfig  ServerConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, channelId])
  @@map("guide_state")
}

model WizardState {
  id                String    @id @default(cuid())
  guildId           String    @unique
  currentStep       String    @default("flow")
  subStep           String?
  completedSteps    Json      @default("[]")
  activeMessageId   String?
  installationMode  Boolean   @default(true)
  editMode          Boolean   @default(false)
  selectedSetupMode String?
  lastAdvancedAt    DateTime?
  lastBuildAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  serverConfig  ServerConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@map("wizard_state")
}

model ChannelTopology {
  id              String    @id @default(cuid())
  guildId         String
  channelKey      String
  channelId       String?
  channelName     String?
  displayLabel    String?
  profileVersion  String?
  lastVerifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  serverConfig  ServerConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, channelKey])
  @@map("channel_topology")
}

model AuditEvent {
  id          BigInt    @id @default(autoincrement())
  guildId     String
  userId      String?
  eventType   String
  category    String?
  channelId   String?
  payload     Json?
  outcome     String?
  errorMsg    String?
  latencyMs   Int?
  createdAt   DateTime  @default(now())

  @@map("audit_events")
}

model PendingOffense {
  id            String    @id
  guildId       String
  userId        String
  channelId     String?
  messageId     String?
  offenseType   String
  reasoning     String?
  teamName      String?
  confidence    String?
  status        String    @default("pending")
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  serverConfig  ServerConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@map("pending_offenses")
}

model OffenseCooldown {
  guildId       String
  userId        String
  lastFlaggedAt DateTime @default(now())

  @@id([guildId, userId])
  @@map("offense_cooldowns")
}

model StreamCredit {
  id          BigInt    @id @default(autoincrement())
  guildId     String
  userId      String
  teamName    String?
  streamUrl   String?
  messageId   String?
  rewardLabel String?
  creditedAt  DateTime  @default(now())

  serverConfig  ServerConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, messageId])
  @@map("stream_credits")
}

model FeatureFlag {
  guildId       String
  flag          String
  enabled       Boolean   @default(false)
  metadata      Json?
  updatedAt     DateTime  @updatedAt

  serverConfig  ServerConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@id([guildId, flag])
  @@map("feature_flags")
}

model BackgroundJob {
  id            String    @id @default(cuid())
  guildId       String
  jobType       String
  status        String    @default("queued")
  triggeredBy   String?
  payload       Json?
  progress      Json?
  result        Json?
  errorMsg      String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  serverConfig  ServerConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@map("background_jobs")
}

model MemberLedger {
  id                  String    @id @default(cuid())
  guildId             String
  userId              String
  discordTag          String?
  joinCount           Int       @default(0)
  leaveCount          Int       @default(0)
  kickCount           Int       @default(0)
  banCount            Int       @default(0)
  totalWarnings       Int       @default(0)
  gameplayWarnings    Int       @default(0)
  closeAppWarnings    Int       @default(0)
  inactivityWarnings  Int       @default(0)
  isBanned            Boolean   @default(false)
  inactivityNotified  Boolean   @default(false)
  lastActivityAt      DateTime?
  lastJoinedAt        DateTime?
  firstJoinedAt       DateTime?
  notes               Json      @default("[]")
  kickHistory         Json      @default("[]")
  banHistory          Json      @default("[]")
  teamHistory         Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  serverConfig  ServerConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@map("member_ledger")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  guildId   String?
  targetId  String?
  details   String?
  severity  String   @default("info")
  timestamp DateTime @default(now())

  @@index([guildId, timestamp])
  @@index([userId, timestamp])
  @@map("audit_log")
}

model MemberProfile {
  id                  String    @id @default(cuid())
  guildId             String
  userId              String
  timezone            String?
  timezoneLabel       String?
  nicknameBase        String?
  lastSeenDisplayName String?
  streamCount         Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([guildId, userId])
  @@map("member_profiles")
}

model GuildLock {
  guildId   String
  lockType  String
  lockedBy  String?
  lockedAt  DateTime @default(now())
  expiresAt DateTime?

  @@id([guildId, lockType])
  @@map("guild_locks")
}


// v204.7 provider control-plane models. League IDs intentionally do not FK to League because
// activeLeagueService supports legacy/non-Prisma league identifiers during migration.
model ProviderConnection {
  id               String   @id
  leagueId         String
  providerKey      String
  status           String   @default("draft")
  healthStatus     String   @default("unknown")
  fallbackMode     String   @default("none")
  endpointUrl      String?
  externalLeagueId String?
  routeTokenHash   String?
  secretCiphertext String?
  config           Json?    @default("{}")
  lastHealthAt     DateTime?
  lastSyncAt       DateTime?
  lastSuccessAt    DateTime?
  lastError        String?
  blockedReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([leagueId, providerKey])
  @@index([providerKey, status])
  @@map("provider_connections")
}

model ProviderSyncRun {
  id            String   @id
  leagueId      String
  providerKey   String
  trigger       String
  status        String
  inputRevision String?
  metadata      Json?    @default("{}")
  result        Json?
  error         String?
  startedAt     DateTime
  finishedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leagueId, providerKey, status])
  @@index([startedAt])
  @@map("provider_sync_runs")
}


model ProviderImportReceipt {
  id                  String   @id
  connectionId        String
  leagueId            String
  providerKey         String
  identityKey         String
  externalEventId     String?
  payloadHash         String?
  stage               String?
  size                Int      @default(0)
  status              String   @default("received")
  artifactBody        String?
  meta                Json?    @default("{}")
  duplicateDeliveries Int      @default(0)
  receivedAt          DateTime @default(now())
  completedAt         DateTime?
  error               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([connectionId, identityKey])
  @@index([leagueId, providerKey, status])
  @@index([providerKey, status, receivedAt])
  @@map("provider_import_receipts")
}

model ProviderTeamMapping {
  id             String   @id
  guildId        String
  leagueId       String
  providerKey    String
  teamId         String
  externalTeamId String
  mappedBy       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([leagueId, providerKey, teamId])
  @@unique([leagueId, providerKey, externalTeamId])
  @@map("provider_team_mappings")
}


// ─────────────────────────────────────────────────────────────────────────────
// Contract v8 G2/G3 — canonical progression/postseason + scale hardening
// PostgreSQL is authoritative for NOFUNBOT-owned progression/season state.
// ─────────────────────────────────────────────────────────────────────────────
model Season {
  id                String   @id
  guildId           String
  leagueId          String
  ordinal           Int?
  year              Int?
  state             String   @default("PRESEASON_SETUP")
  providerSeasonKey String?
  policyVersionId   String?
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([leagueId, ordinal])
  @@index([guildId, leagueId, state])
  @@map("seasons")
}

model ProgressionPolicyVersion {
  id          String   @id
  guildId     String
  leagueId    String
  seasonId    String
  version     Int
  effectiveAt DateTime
  policy      Json
  createdBy   String
  createdAt   DateTime @default(now())

  @@unique([seasonId, version])
  @@index([guildId, leagueId, seasonId])
  @@map("progression_policy_versions")
}

model TierAssignment {
  id          String   @id
  guildId     String
  leagueId    String
  seasonId    String
  teamId      String
  tier        String
  mode        String
  sourceSeed  String?
  manualActor String?
  finalizedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([seasonId, teamId])
  @@index([guildId, leagueId, seasonId])
  @@map("tier_assignments")
}

model ProgressionGrant {
  id              String   @id
  guildId         String
  leagueId        String
  seasonId        String
  ownerType       String
  ownerId         String
  rewardType      String
  quantity        Int      @default(1)
  points          Int      @default(0)
  sourceType      String
  sourceId        String   @default("")
  status          String   @default("AVAILABLE")
  expiresAt       DateTime?
  policyVersionId String
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([seasonId, ownerType, ownerId, rewardType, sourceType, sourceId])
  @@index([guildId, leagueId, seasonId, ownerType, ownerId, status])
  @@map("progression_grants")
}

model ProgressionWallet {
  id         String   @id
  guildId    String
  leagueId   String
  seasonId   String
  ownerType  String
  ownerId    String
  currency   String
  earned     Int      @default(0)
  spent      Int      @default(0)
  forfeited  Int      @default(0)
  locked     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([seasonId, ownerType, ownerId, currency])
  @@index([guildId, leagueId, seasonId])
  @@map("progression_wallets")
}

model ProgressionClaim {
  id                 String   @id
  guildId            String
  leagueId           String
  seasonId           String
  membershipId       String
  teamId             String
  playerId           String
  grantId            String?
  walletId           String?
  policyVersionId    String
  idempotencyKey     String
  requestedMutations Json
  status             String   @default("PENDING")
  actorId            String
  approvedBy         String?
  requestedAt        DateTime @default(now())
  approvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([guildId, idempotencyKey])
  @@index([guildId, leagueId, seasonId, membershipId, status])
  @@map("progression_claims")
}

model PlayerMutation {
  id                   String   @id
  guildId              String
  leagueId             String
  seasonId             String
  membershipId         String?
  teamId               String
  playerId             String
  claimId              String
  mutationType         String
  attributeKey         String?
  points               Int      @default(0)
  before               Json?
  after                Json?
  providerVerification Json?
  status               String   @default("APPLIED")
  actorId              String
  appliedAt            DateTime
  createdAt            DateTime @default(now())

  @@index([guildId, leagueId, seasonId, teamId, playerId])
  @@index([claimId])
  @@map("player_mutations")
}

model EntitlementConsumption {
  id         String   @id
  grantId    String
  claimId    String
  mutationId String
  quantity   Int      @default(1)
  consumedAt DateTime @default(now())

  @@unique([grantId, claimId])
  @@unique([mutationId])
  @@map("entitlement_consumptions")
}

model MembershipTenure {
  id            String   @id
  guildId       String
  leagueId      String
  seasonId      String?
  membershipId  String
  userId        String
  teamId        String?
  joinedAt      DateTime
  leftAt        DateTime?
  departureType String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([guildId, leagueId, userId, leftAt])
  @@index([membershipId, leftAt])
  @@map("membership_tenures")
}

model PostseasonBracket {
  id        String   @id
  guildId   String
  leagueId  String
  seasonId  String
  format    String
  seedCount Int
  seeds     Json
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId])
  @@index([guildId, leagueId, status])
  @@map("postseason_brackets")
}

model PostseasonMatch {
  id             String   @id
  bracketId      String
  seasonId       String
  round          Int
  slot           Int
  homeTeamId     String?
  awayTeamId     String?
  winnerTeamId   String?
  status         String   @default("PENDING")
  advancesToId   String?
  providerGameId String?
  resultEvidence Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([bracketId, round, slot])
  @@index([seasonId, status])
  @@map("postseason_matches")
}

model OperationFence {
  guildId   String
  key       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([guildId, key])
  @@index([expiresAt])
  @@map("operation_fences")
}

model CompatibilityPath {
  compatId         String   @id
  owner            String
  replacement      String
  removalCondition String
  deadlineRelease  String
  hits             BigInt   @default(0)
  lastHitAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("compatibility_paths")
}

model LegacyProgressionMigration {
  id         String   @id
  guildId    String
  leagueId   String
  seasonId   String?
  sourceType String
  sourceId   String
  userId     String?
  status     String   @default("REVIEW_REQUIRED")
  payload    Json
  resolution Json?    @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([guildId, sourceType, sourceId])
  @@index([guildId, leagueId, seasonId, status])
  @@map("legacy_progression_migrations")
}
