# Existing bot env vars stay the same.
# New optional stack vars for the scaffolded upgrade:
DATABASE_URL="postgresql://user:password@localhost:5432/nofunleague"
REDIS_URL="redis://localhost:6379"
APP_ENV=production
RELEASE_CHANNEL=stable
RUN_PRISMA_MIGRATIONS_ON_BOOT=true
RUN_DB_BOOTSTRAP_ON_BOOT=true
RUN_JSON_MIGRATION_ON_BOOT=false
ENABLE_QUEUE_WORKER=true
BOT_DATA_DIR=./data

# ─── Conversational multimodal media context ───
# Lets member/commissioner/IT conversation understand Discord-hosted images, memes, GIFs, stickers, and short video frames.
# Raw media is not persisted. Only a short semantic description enters short-lived conversation memory.
MEDIA_CONTEXT_ENABLED=true
# Per media item fetch ceiling. Keep this bounded to control memory/API cost.
MEDIA_CONTEXT_MAX_BYTES=20971520
# Maximum media items analyzed from one message/reply chain.
MEDIA_CONTEXT_MAX_ITEMS=3
# Representative frames sampled from an animated GIF or short video.
MEDIA_CONTEXT_MAX_FRAMES=4
# Only the first bounded slice of video is sampled; audio is not transcribed.
MEDIA_CONTEXT_VIDEO_SECONDS=12
# Cache semantic media analysis for duplicate Discord retries/re-edits.
MEDIA_CONTEXT_CACHE_MS=300000
# Direct static-image budget sent to the vision API. Larger static images are skipped instead of overloading the request.
MEDIA_CONTEXT_MAX_STATIC_API_BYTES=4194304
# Optional override. Docker/Railway installs ffmpeg in the image, so normally leave this unset.
# FFMPEG_PATH=/usr/bin/ffmpeg
